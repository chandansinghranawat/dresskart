<%- include('../partials/header') %>

<div class="page-hero">
  <div class="container">
    <h1>Checkout</h1>
    <nav class="breadcrumb">
      <a href="/">Home</a> <i class="fas fa-chevron-right"></i>
      <a href="/cart">Cart</a> <i class="fas fa-chevron-right"></i>
      <span>Checkout</span>
    </nav>
  </div>
</div>

<section class="section">
  <div class="container">
    <form action="/orders/place" method="POST" class="checkout-layout">

      <!-- Shipping Details -->
      <div class="checkout-main">
        <div class="checkout-card">
          <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
          <div class="form-grid">
            <div class="form-group">
              <label>Full Name *</label>
              <input type="text" name="shipping_name" value="<%= userInfo.name %>" required>
            </div>
            <div class="form-group">
              <label>Phone Number *</label>
              <input type="tel" name="shipping_phone" value="<%= userInfo.phone || '' %>" required placeholder="+91 XXXXXXXXXX">
            </div>
            <div class="form-group full-width">
              <label>Complete Address *</label>
              <textarea name="shipping_address" required rows="2" placeholder="House No., Street, Area..."><%= userInfo.address || '' %></textarea>
            </div>
            <div class="form-group">
              <label>City *</label>
              <input type="text" name="shipping_city" value="<%= userInfo.city || '' %>" required>
            </div>
            <div class="form-group">
              <label>State *</label>
              <select name="shipping_state" required>
                <option value="">Select State</option>
                <% ['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh','Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal','Delhi','Jammu & Kashmir'].forEach(state => { %>
                  <option value="<%= state %>" <%= userInfo.state === state ? 'selected' : '' %>><%= state %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>Pincode *</label>
              <input type="text" name="shipping_pincode" value="<%= userInfo.pincode || '' %>" required pattern="[0-9]{6}" placeholder="6 digit pincode">
            </div>
          </div>
        </div>

        <div class="checkout-card">
          <h3><i class="fas fa-credit-card"></i> Payment Method</h3>
          <div class="payment-options">
            <label class="payment-opt selected">
              <input type="radio" name="payment_method" value="COD" checked>
              <i class="fas fa-money-bill-wave"></i>
              <div>
                <strong>Cash on Delivery</strong>
                <span>Pay when your order arrives</span>
              </div>
            </label>
            <label class="payment-opt">
              <input type="radio" name="payment_method" value="UPI">
              <i class="fas fa-mobile-alt"></i>
              <div>
                <strong>UPI Payment</strong>
                <span>Pay via PhonePe, GPay, Paytm</span>
              </div>
            </label>
            <label class="payment-opt">
              <input type="radio" name="payment_method" value="Net Banking">
              <i class="fas fa-university"></i>
              <div>
                <strong>Net Banking</strong>
                <span>All major banks supported</span>
              </div>
            </label>
          </div>
        </div>

        <div class="checkout-card">
          <h3><i class="fas fa-sticky-note"></i> Order Notes (Optional)</h3>
          <textarea name="notes" rows="2" placeholder="Any special instructions for your order..."></textarea>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="checkout-sidebar">
        <div class="summary-card">
          <h3>Order Summary</h3>
          <div class="checkout-items">
            <% cartItems.forEach(item => { %>
              <div class="checkout-item">
                <div class="checkout-item-img">
                  <div class="product-img-placeholder tiny"><i class="fas fa-vest"></i></div>
                  <span class="qty-badge"><%= item.quantity %></span>
                </div>
                <div class="checkout-item-name">
                  <span><%= item.name %></span>
                  <% if (item.size) { %><small>Size: <%= item.size %></small><% } %>
                </div>
                <span class="checkout-item-price">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
              </div>
            <% }) %>
          </div>
          <div class="summary-row">
            <span>Subtotal</span>
            <span>₹<%= total.toLocaleString('en-IN') %></span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span class="<%= shipping === 0 ? 'text-green' : '' %>"><%= shipping === 0 ? 'FREE' : '₹'+shipping %></span>
          </div>
          <div class="summary-row total-row">
            <strong>Total</strong>
            <strong>₹<%= grandTotal.toLocaleString('en-IN') %></strong>
          </div>
          <button type="submit" class="btn btn-primary btn-full btn-lg">
            <i class="fas fa-check"></i> Place Order
          </button>
          <div class="secure-note"><i class="fas fa-lock"></i> Secure Checkout</div>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
// Highlight selected payment method
document.querySelectorAll('.payment-opt input').forEach(radio => {
  radio.addEventListener('change', function() {
    document.querySelectorAll('.payment-opt').forEach(el => el.classList.remove('selected'));
    this.closest('.payment-opt').classList.add('selected');
  });
});
</script>

<%- include('../partials/footer') %>
