          <div class="dk-collection-card-content">

            <span class="dk-collection-card-kicker">
              DressKart Professional
            </span>

            <h3>
              <%= [
                'Professional Uniforms',
                'Premium Workwear',
                'Petroleum Staff Collection',
                'Branded Caps',
                'Utility Bags',
                'Safety Workwear',
                'Team Uniform Sets',
                'Staff Accessories',
                'Complete DressKart Range'
              ][index] %>
            </h3>

            <span class="dk-collection-card-link">
              Explore Products
              <i class="fa-solid fa-arrow-right"></i>
            </span>

          </div>

        </a>

      <% }) %>

    </div>

    <!-- Bottom collection strip -->
    <div class="dk-collection-bottom">

