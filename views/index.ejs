          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="products-grid">

        <% homeNewArrivals.forEach((product, index) => { %>

          <article class="product-card">

            <a
              href="<%= getProductLink(product) %>"
              class="product-img-wrap"
            >
              <div class="product-img-placeholder">
                <img
                  src="<%= homeImages.arrivals[index % homeImages.arrivals.length] %>"
                  alt="<%= product.name %>"
                  class="home-real-image"
                  loading="lazy"
                  onerror="this.onerror=null;this.src='/img/Screenshot 2026-08-01 142217.png';"
                >
              </div>

              <span class="badge-new">New</span>

              <% if (product.is_dummy) { %>
                <span class="badge-demo">Demo</span>
              <% } %>

              <span class="product-quick-view">View Product</span>
            </a>

            <div class="product-info">
              <span class="product-cat">
                <%= product.category_name %>
              </span>

              <h3>
                <a href="<%= getProductLink(product) %>">
                  <%= product.name %>
                </a>
              </h3>

              <div class="product-price">
                <span class="price">
                  ₹<%= Number(product.price).toLocaleString('en-IN') %>
                </span>

                <% if (product.original_price && product.original_price > product.price) { %>
                  <span class="price-old">
                    ₹<%= Number(product.original_price).toLocaleString('en-IN') %>
                  </span>
                <% } %>
              </div>

              <a
                href="<%= getProductLink(product) %>"
                class="btn btn-primary btn-sm btn-full"
              >
                View Details
              </a>
            </div>

          </article>

        <% }) %>

      </div>

    </div>
  </section>

