    ),
    linear-gradient(
      135deg,
      #0b111d 0%,
      #101b2d 55%,
      #122238 100%
    );
  overflow: hidden;
}

.dk-responsive-hero-container {
  position: relative;
  z-index: 2;
  width: min(1050px, calc(100% - 32px));
  min-height: 500px;
  margin: 0 auto;
  padding: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
  align-items: center;
