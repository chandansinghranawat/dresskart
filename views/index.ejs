          <h2>Featured products</h2>
          <p>
            Our most popular uniforms and accessories selected for
            petroleum professionals.
          </p>
        </div>

        <a href="/products" class="btn btn-outline-sm">
          View All Products
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="products-grid">

        <% homeFeaturedProducts.forEach((product, index) => { %>

          <article class="product-card">

            <a
              href="<%= getProductLink(product) %>"
              class="product-img-wrap"
            >
              <div class="product-img-placeholder">
                <img
                  src="<%= getProductImage(product, homeImages.featured, index) %>"
                  alt="<%= product.name %>"
                  class="home-real-image"
                  loading="lazy"
                  onerror="this.onerror=null;this.src='<%= homeImages.featured[index % homeImages.featured.length] %>';"
                >
              </div>

              <% if (product.original_price && product.original_price > product.price) { %>
                <span class="badge-sale">
                  <%= Math.round((1 - product.price / product.original_price) * 100) %>% OFF
                </span>
              <% } %>

              <% if (product.is_featured) { %>
                <span class="badge-featured">Featured</span>
              <% } %>

              <% if (product.is_dummy) { %>
                <span class="badge-demo">Demo</span>
              <% } %>

              <span class="product-quick-view">View Product</span>
            </a>

            <div class="product-info">

              <span class="product-cat">
                <%= product.category_name %>
              </span>

              <h3>
                <a href="<%= getProductLink(product) %>">
                  <%= product.name %>
                </a>
              </h3>

              <div class="product-rating">
                <span>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                </span>
                <small>Premium quality</small>
              </div>

              <div class="product-price">
                <span class="price">
                  ₹<%= Number(product.price).toLocaleString('en-IN') %>
                </span>

                <% if (product.original_price && product.original_price > product.price) { %>
                  <span class="price-old">
                    ₹<%= Number(product.original_price).toLocaleString('en-IN') %>
                  </span>
                <% } %>
              </div>

              <div class="product-actions">

                <a
                  href="<%= getProductLink(product) %>"
                  class="btn btn-primary btn-sm product-details-btn"
                >
                  View Details
                </a>

                <% if (product.is_dummy) { %>

                  <a
                    href="/products"
                    class="btn btn-icon"
                    title="Browse available products"
                    aria-label="Browse available products"
                  >
                    <i class="fa-solid fa-arrow-right"></i>
                  </a>

                <% } else if (user) { %>

                  <form action="/cart/add" method="POST">
                    <input
                      type="hidden"
                      name="product_id"
                      value="<%= product.id %>"
                    >
                    <input
                      type="hidden"
                      name="quantity"
                      value="1"
                    >
                    <button
                      type="submit"
                      class="btn btn-icon"
                      title="Add to Cart"
                      aria-label="Add product to cart"
                    >
                      <i class="fa-solid fa-bag-shopping"></i>
                    </button>
                  </form>

                <% } else { %>

                  <a
                    href="/auth/login"
                    class="btn btn-icon"
                    title="Login to add product"
                    aria-label="Login to add product to cart"
                  >
                    <i class="fa-solid fa-bag-shopping"></i>
                  </a>

                <% } %>

              </div>

            </div>

          </article>

        <% }) %>

      </div>

    </div>
  </section>

  
