<style>

  /* ============================================================
     HERO SLIDER MAIN
  ============================================================ */

  .dk-hero-slider {
    position: relative;
    width: 100%;
    min-height: 500px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(214, 173, 50, 0.08),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #0b111d 0%,
        #101b2d 55%,
        #122238 100%
      );
  }


  /* ============================================================
     SLIDES WRAPPER
  ============================================================ */

  .dk-hero-slides {
    position: relative;
    width: 100%;
    min-height: 500px;
  }


  /* ============================================================
     SINGLE SLIDE
  ============================================================ */

  .dk-hero-slide {
    position: absolute;
    inset: 0;

    width: 100%;
    min-height: 500px;

    display: flex;
    align-items: center;

    opacity: 0;
    visibility: hidden;

    transform: translateX(35px);

    transition:
      opacity 0.65s ease,
      transform 0.65s ease,
      visibility 0.65s ease;

    pointer-events: none;
  }


  .dk-hero-slide.active {
    position: relative;

    opacity: 1;
    visibility: visible;

    transform: translateX(0);

    pointer-events: auto;
  }


  /* ============================================================
     CONTAINER
  ============================================================ */

  .dk-hero-slide-container {
    position: relative;
    z-index: 5;

    width: min(1050px, calc(100% - 32px));
    min-height: 500px;

    margin: 0 auto;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 380px);

    align-items: center;

    gap: 60px;
  }


  /* ============================================================
     LEFT CONTENT
  ============================================================ */

  .dk-hero-slide-content {
    position: relative;
    z-index: 5;

    min-width: 0;
    max-width: 620px;
  }


  /* small badge */

  .dk-hero-slide-badge {
    width: fit-content;

    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 18px;

    padding: 7px 13px;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;

    background: rgba(255, 255, 255, 0.055);

    color: #f5c451;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 0.8px;

    text-transform: uppercase;

    backdrop-filter: blur(10px);
  }


  .dk-hero-slide-badge i {
    color: #f47b20;
  }


  /* heading */

  .dk-hero-slide-title {
    margin: 0;

    color: #ffffff;

    font-family:
      "Bodoni Moda",
      "Times New Roman",
      serif;

    font-size: clamp(40px, 4.4vw, 62px);

    font-weight: 500;

    letter-spacing: -0.045em;

    line-height: 1.05;
  }


  .dk-hero-slide-title span {
    display: block;

    margin-top: 5px;

    color: #ff6b45;
  }


  /* description */

  .dk-hero-slide-description {
    max-width: 520px;

    margin: 18px 0 0;

    color: #aeb9c9;

    font-size: 12px;

    font-weight: 400;

    line-height: 1.8;
  }


  /* ============================================================
     BUTTONS
  ============================================================ */

  .dk-hero-slide-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 24px;
  }


  .dk-hero-primary-btn,
  .dk-hero-secondary-btn {
    min-height: 43px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    padding: 10px 18px;

    border-radius: 10px;

    font-size: 10px;
    font-weight: 700;

    text-decoration: none;

    transition:
      transform 0.22s ease,
      background 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease;
  }


  /* primary */

  .dk-hero-primary-btn {
    border: 1px solid #19372f;

    background:
      linear-gradient(
        135deg,
        #14705e,
        #0e584a
      );

    color: #ffffff;

    box-shadow:
      0 12px 26px rgba(15, 122, 104, 0.28);
  }


  .dk-hero-primary-btn:hover {
    background:
      linear-gradient(
        135deg,
        #16967d,
        #0b5c4f
      );

    color: #ffffff;

    transform: translateY(-2px);
  }


  /* secondary */

  .dk-hero-secondary-btn {
    border:
      1px solid rgba(255, 255, 255, 0.28);

    background:
      rgba(255, 255, 255, 0.05);

    color: #ffffff;

    backdrop-filter: blur(8px);
  }


  .dk-hero-secondary-btn:hover {
    border-color: #ffffff;

    background: #ffffff;

    color: #0f1c2d;

    transform: translateY(-2px);
  }


  /* ============================================================
     RIGHT IMAGE
  ============================================================ */

  .dk-hero-slide-visual {
    position: relative;

    min-width: 0;
    min-height: 400px;

    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* circle behind image */

  .dk-hero-image-ring {
    position: absolute;

    width: 440px;
    height: 440px;

    border:
      1px solid rgba(214, 173, 50, 0.35);

    border-radius: 50%;

    animation:
      dkHeroRingRotate 22s linear infinite;
  }


  .dk-hero-image-ring::before {
    position: absolute;

    inset: -50px;

    border:
      35px solid rgba(255, 255, 255, 0.02);

    border-radius: 50%;

    content: "";
  }


  .dk-hero-image-ring::after {
    position: absolute;

    top: 28px;
    right: 24px;

    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: #f5b342;

    box-shadow:
      0 0 18px rgba(245, 179, 66, 0.8);

    content: "";
  }


  @keyframes dkHeroRingRotate {

    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }

  }


  /* product image card */

  .dk-hero-product-card {
    position: relative;
    z-index: 3;

    width: 100%;
    max-width: 330px;

    overflow: hidden;

    border:
      1px solid rgba(255, 255, 255, 0.14);

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.28);

    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }


  .dk-hero-product-card:hover {
    transform: translateY(-5px);

    box-shadow:
      0 32px 75px rgba(0, 0, 0, 0.35);
  }


  .dk-hero-product-image {
    width: 100%;

    aspect-ratio: 4 / 5;

    overflow: hidden;
  }


  .dk-hero-product-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    object-position: center top;

    transition:
      transform 0.8s ease;
  }


  .dk-hero-slide.active
  .dk-hero-product-image img {
    animation:
      dkHeroImageZoom 6s ease forwards;
  }


  @keyframes dkHeroImageZoom {

    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.045);
    }

  }


  /* ============================================================
     IMAGE LABEL
