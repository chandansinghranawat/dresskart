    }
  ];

  const homeFeaturedProducts =
    typeof featuredProducts !== 'undefined' &&
    Array.isArray(featuredProducts) &&
    featuredProducts.length > 0
      ? featuredProducts.slice(0, 4)
      : dummyFeaturedProducts;

  const homeNewArrivals =
    typeof newArrivals !== 'undefined' &&
    Array.isArray(newArrivals) &&
    newArrivals.length > 0
      ? newArrivals.slice(0, 4)
      : dummyNewArrivals;

  const getProductLink = (product) =>
    product && product.is_dummy
      ? '/products'
      : `/products/${product.slug}`;

  const getProductImage = (product, fallbackImages, index) => {
    const fallback = fallbackImages[index % fallbackImages.length];

    const normalizeImagePath = (value) => {
      if (!value || typeof value !== 'string') return null;

      const cleanValue = value.trim();
      const isRemoteImage = /^https?:\/\//i.test(cleanValue);
      const isDataImage = /^data:image\//i.test(cleanValue);
      const hasImageExtension = /\.(png|jpe?g|webp|gif|avif|svg)(\?.*)?$/i.test(cleanValue);

      if (!isRemoteImage && !isDataImage && !hasImageExtension) {
        return null;
      }

      if (isRemoteImage || isDataImage || cleanValue.startsWith('/')) {
        return cleanValue;
      }

      return `/uploads/${cleanValue}`;
    };

    return (
      normalizeImagePath(product && product.image) ||
      normalizeImagePath(product && product.image_url) ||
      fallback
    );
  };
