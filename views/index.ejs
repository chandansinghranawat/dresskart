  max-width: 620px;
}

.dk-responsive-hero-title {
  margin: 0;
  color: #ffffff;
  font-family: "Manrope", sans-serif;
  font-size: clamp(40px, 4.4vw, 62px);
  font-weight: 800;
  letter-spacing: -2.4px;
  line-height: 1.05;
}

.dk-responsive-hero-title span {
  display: block;
  margin-top: 4px;
  color: #ff6b45;
}

.dk-responsive-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

.dk-responsive-primary-btn,
.dk-responsive-secondary-btn {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 17px;
  border-radius: 10px;
  font-size: 10px;
  font-weight: 700;
  transition:
    transform 0.22s ease,
    background-color 0.22s ease,
    border-color 0.22s ease,
    color 0.22s ease;
}

.dk-responsive-primary-btn {
  border: 1px solid #0e1828;
  background: #131d19;
  color: #ffffff;
  box-shadow: 0 12px 26px rgba(15, 122, 104, 0.28);
}

.dk-responsive-primary-btn:hover {
  background:
    linear-gradient(
      135deg,
      #14917a,
      #0b5c4f
    );
  color: #ffffff;
  transform: translateY(-2px);
}

.dk-responsive-secondary-btn {
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  backdrop-filter: blur(8px);
}

.dk-responsive-secondary-btn:hover {
  border-color: #ffffff;
  background: #ffffff;
  color: #0f1c2d;
  transform: translateY(-2px);
}

/* Right image area */

.dk-responsive-hero-visual {
  position: relative;
  min-width: 0;
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dk-responsive-image-ring {
  position: absolute;
  width: 440px;
  height: 440px;
  border: 1px solid rgba(214, 173, 50, 0.35);
  border-radius: 50%;
}

.dk-responsive-image-ring::before {
  position: absolute;
  inset: -50px;
  border: 35px solid rgba(255, 255, 255, 0.02);
  border-radius: 50%;
  content: "";
}

.dk-responsive-product-card {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 330px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  overflow: hidden;
}

.dk-responsive-product-image {
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
}

.dk-responsive-product-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center top;
}

/* Decorations */

.dk-responsive-hero-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.dk-responsive-decoration-one {
  top: -180px;
  right: -180px;
  width: 500px;
  height: 500px;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.dk-responsive-decoration-two {
  right: 60px;
  bottom: -330px;
